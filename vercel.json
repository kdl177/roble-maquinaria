      "statusCode": 301
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "maqdemad.vercel.app"
        }
      ],
      "destination": "https://roble-maquinaria.vercel.app/",
      "statusCode": 308
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "maqdemad.vercel.app"
        }
      ],
      "destination": "https://roble-maquinaria.vercel.app/:path*",
      "statusCode": 308
    },
